<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atp.agent.mapper.AgentMapper">

    <select id="getByCode" resultType="com.atp.pojo.entity.agent.AgentMeta">
        SELECT * FROM agent WHERE code = #{code} AND deleted = 0 AND enabled = 1
    </select>

    <select id="getById" resultType="com.atp.pojo.entity.agent.AgentMeta">
        SELECT * FROM agent WHERE id = #{id} AND deleted = 0 AND enabled = 1
    </select>
</mapper>