<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atp.agent.mapper.AgentToolMetaMapper">

    <select id="getByCode" resultType="com.atp.pojo.entity.agent.AgentToolMeta">
        SELECT * FROM agent_tool WHERE code = #{code} AND enabled = 1
    </select>

    <select id="listAll" resultType="com.atp.pojo.entity.agent.AgentToolMeta">
        SELECT * FROM agent_tool WHERE enabled = 1 ORDER BY id
    </select>
</mapper>
